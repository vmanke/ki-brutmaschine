# Beispiel für die geheimen Dateien der verdeckten Bewertung (brut-eval).
#
# Diese Datei enthält nur Platzhalter in spitzen Klammern. Bitte tragen Sie
# hier niemals echte Werte ein und legen Sie keine echten Geheimnisse ins Git.
# Nur brut-eval liest die echten Dateien. Der Orchestrator (brut run) öffnet
# sie nie.
#
# Es gibt zwei getrennte geheime Dateien:
#   1. MLP-Modus:    <run_dir>/secret/hidden.env, eine je Lauf.
#                    Sie entsteht mit "brut init <run_dir>".
#   2. Lerner-Modus: ~/.brut/learner/hidden.env, eine je Rechner.
#                    Sie entsteht mit "brut learner secret-init".
# Die Dateien haben die Rechte 0600, ihre Ordner 0700.

# ---------------------------------------------------------------------------
# 1. MLP-Modus: <run_dir>/secret/hidden.env
# ---------------------------------------------------------------------------

# Seed des geheimen Testdatensatzes: ganze Zahl ohne Vorzeichen (u64).
BRUT_HIDDEN_SEED=<wird-von-brut-init-erzeugt>

# Optional: Obergrenze für die Zahl der verdeckten Abfragen.
# brut-eval nimmt den kleineren Wert von diesem und --budget.
# BRUT_HIDDEN_BUDGET=<ganze Zahl, zum Beispiel 30>

# Optional: Untergrenze für die Rundungsstufe der verdeckten Werte.
# brut-eval nimmt den größten Wert von diesem, 0,01 und --step.
# BRUT_HIDDEN_STEP=<Zahl, zum Beispiel 0.01>

# Optional: der einzige Ordner, aus dem brut-eval Modelldateien liest.
# Standard: der Ordner models/ des Lauf-Verzeichnisses (neben secret/).
# BRUT_MODELS_DIR=</pfad/zum/lauf/models>

# ---------------------------------------------------------------------------
# 2. Lerner-Modus: ~/.brut/learner/hidden.env
# ---------------------------------------------------------------------------
# Im selben Ordner legt brut-eval das Abfragebuch (ledger.jsonl), die
# Sperrdatei (eval.lock) und den Zwischenspeicher der Vergleichsverfahren
# (baseline_cache.json) an.

# Seed der verdeckten Aufgaben: ganze Zahl ohne Vorzeichen (u64).
# Aus ihm entstehen alle verdeckten Aufgaben, auch die 40 geheimen
# Grammatik-Familien des Hauptwerts.
BRUT_LEARNER_HIDDEN_SEED=<wird-von-brut-learner-secret-init-erzeugt>

# Höchstzahl verdeckter Abfragen je Protokollversion, über alle Läufe.
# brut learner secret-init trägt 48 ein.
# BRUT_LEARNER_BUDGET_TOTAL=<ganze Zahl, Standard 48>

# Höchstzahl verdeckter Abfragen je Lauf. brut learner secret-init trägt 12 ein.
# Das Flag --budget kann den Wert nur senken, nie erhöhen.
# BRUT_LEARNER_BUDGET_PER_RUN=<ganze Zahl, Standard 12>

# Optional: Untergrenze der Rundungsstufe, wie im MLP-Modus (mindestens 0,01).
# BRUT_HIDDEN_STEP=<Zahl, zum Beispiel 0.01>

# Nur für die ARC-Prüfung: der Ordner mit den ARC-Daten und die Manifest-Datei
# mit den SHA-256-Hashes aller Dateien. Diese Pfade stehen nur hier, nie im
# Code des Orchestrators. brut learner secret-init trägt sie mit --arc-root
# und --manifest ein.
# BRUT_ARC_DATA_ROOT=</absoluter/pfad/zu/data/external>
# BRUT_ARC_MANIFEST=</absoluter/pfad/zu/data/external/manifest.json>

# Höchstzahl der ARC-Prüfungen je Bewertungssatz und Protokollversion.
# brut learner secret-init trägt 3 ein.
# BRUT_ARC_BUDGET_PER_SET=<ganze Zahl, Standard 3>
